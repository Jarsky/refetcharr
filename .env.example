# Required
MEDIA_PATH=/mnt/media           # the host folder Radarr mounts as /data (the file checks read downloads from here)
DOCKER_NETWORK=arr              # the Docker network Radarr (and qBittorrent) are on: docker network ls

# Optional (the Radarr connection can also be set in Settings, which wins)
RADARR_API_KEY=                 # Radarr → Settings → General → API Key
RADARR_URL=http://radarr:7878   # Radarr on the same Docker network
PUID=1000                       # a user that can read the media
PGID=1000                       # ...and its group
TZ=Etc/UTC                      # for the schedule and the daily limit, e.g. Europe/London
WEB_PORT=8787
MEM_LIMIT=512m
